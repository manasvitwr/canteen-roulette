rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Public read collections ───────────────────────────────────────────────
    // canteens and menu_items are static reference data — anyone can read them.
    // All writes (seeding) are done via the admin-only seed page which runs in
    // dev mode with service account access; no client-side writes needed here.

    match /canteens/{canteenId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /menu_items/{itemId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── Auth-gated collections ────────────────────────────────────────────────

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }
  }
}
